Set-Content infrastructure/backend.tf.example @"
# backend.tf.example
# Copy to backend.tf and fill in your values
terraform {
  backend "s3" {
    bucket         = "your-tfstate-bucket-name"
    key            = "prod/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "your-lock-table-name"
    encrypt        = true
  }
}
"@